# --- Ma'lumotlar bazasi (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edo"

# --- API (NestJS) ---
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=8h
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Saytning ommaviy manzili - xat QR kodlari shu manzilga ishora qiladi
PUBLIC_APP_URL=http://localhost:5173

# --- Web (React) ---
VITE_API_URL=http://localhost:4000

# --- Ixtiyoriy: oddiy xatlar uchun AI (kalit bo'lmasa mahalliy yordamchi ishlaydi) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Ixtiyoriy: ERI (E-IMZO) orqali kirish. Odatda saytdan kiritiladi (Tashqi tizimlar → ERI) ---
# EIMZO_SERVER_URL=http://e-imzo-server:8080
# EIMZO_DOMAIN=edo.wafaleasing.uz
# EIMZO_API_KEY=

# --- Ixtiyoriy: CRM (faqat o'qish). Bo'sh bo'lsa "CRM'dan tanlash" ko'rinmaydi. Bax: docs/CRM-INTEGRATION.md ---
CRM_DATABASE_URL=
# Mijoz telefonlari manbai (standart https://wafaleasing.uz/crm.html, "off" - o'chirish)
# CRM_PHONES_URL=
