// EDO (Elektron Hujjat Aylanishi) - asosiy ma'lumotlar bazasi sxemasi
// Yangi jadval/maydon qo'shish kerak bo'lsa: shu faylni tahrirlang,
// so'ng `npm run prisma:migrate --workspace=apps/api` ni ishga tushiring.
//
// ESLATMA: SQLite native enum va Json turlarini qo'llab-quvvatlamaydi,
// shuning uchun "enum bo'lishi kerak" maydonlar String sifatida saqlanadi.
// Ruxsat etilgan qiymatlar apps/api/src/common/enums.ts faylida va
// packages/shared-types/src/enums.ts da belgilangan — validatsiya shu
// yerdagi TypeScript enum'lar va class-validator orqali amalga oshadi.
// Production'da PostgreSQL'ga o'tilganda, shu maydonlarni haqiqiy
// Prisma enum'iga qaytarish mumkin (schema'da enum bloklarini tiklab).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  passwordHash String
  /// Qiymatlar: ADMIN | MANAGER | EMPLOYEE | AUDITOR (bax. common/enums.ts -> Role)
  role         String   @default("EMPLOYEE")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  documents        Document[]        @relation("DocumentOwner")
  workflowSteps    WorkflowStep[]    @relation("StepApprover")
  documentVersions DocumentVersion[] @relation("VersionAuthor")
  signatures       Signature[]       @relation("Signer")
  auditLogs        AuditLog[]        @relation("AuditUser")
  letters          Letter[]          @relation("LetterAuthor")
  hrOrders         HrOrder[]
  approvedLeaves   Leave[]           @relation("LeaveApprover")
  employeeCard     Employee?         @relation("EmployeeUser")
  givenGratitudes  Gratitude[]       @relation("GratitudeFrom")

  @@index([email])
}

/// Asosiy hujjat: title, turi, holati va WAFA GROUP CRM'dagi
/// shartnomaga bog'lanish uchun contractRefId (tashqi tizim ID'si, ixtiyoriy).
model Document {
  id      String @id @default(uuid())
  title   String
  /// Qiymatlar: CONTRACT | INVOICE | ORDER | APPLICATION | OTHER
  type    String @default("OTHER")
  /// Qiymatlar: DRAFT | IN_REVIEW | PENDING_SIGNATURE | SIGNED | REJECTED | ARCHIVED
  status  String @default("DRAFT")
  ownerId String
  owner   User   @relation("DocumentOwner", fields: [ownerId], references: [id])

  contractRefId String? // tashqi CRM'dagi shartnoma ID'si (integratsiya nuqtasi)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  versions  DocumentVersion[]
  workflow  Workflow?
  auditLogs AuditLog[]

  @@index([status])
  @@index([contractRefId])
}

/// Har bir hujjatning versiyalari - fayl har tahrirlanganda yangi versiya yaratiladi,
/// eskilari o'chirilmaydi (audit va yuridik talab uchun).
model DocumentVersion {
  id            String   @id @default(uuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber Int
  fileUrl       String
  fileName      String
  fileSizeBytes Int
  note          String?
  createdById   String
  createdBy     User     @relation("VersionAuthor", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())

  signatures Signature[]

  @@unique([documentId, versionNumber])
}

/// Har bir hujjatga bog'langan tasdiqlash zanjiri (workflow).
model Workflow {
  id         String   @id @default(uuid())
  documentId String   @unique
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// Qiymatlar: SEQUENTIAL | PARALLEL
  type        String    @default("SEQUENTIAL")
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  steps WorkflowStep[]
}

/// Workflow ichidagi bitta bosqich - kim tasdiqlaydi, qaysi tartibda.
model WorkflowStep {
  id         String   @id @default(uuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  order      Int
  approverId String
  approver   User     @relation("StepApprover", fields: [approverId], references: [id])
  /// Qiymatlar: PENDING | APPROVED | REJECTED | SKIPPED
  status     String    @default("PENDING")
  comment    String?
  decidedAt  DateTime?

  @@unique([workflowId, order])
}

/// Elektron imzo yozuvi - hozircha MOCK provider, keyinchalik EIMZO bilan almashtiriladi.
model Signature {
  id                String          @id @default(uuid())
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  signerId          String
  signer            User            @relation("Signer", fields: [signerId], references: [id])
  /// Qiymatlar: MOCK | EIMZO
  provider String @default("MOCK")
  /// Qiymatlar: PENDING | SIGNED | FAILED
  status            String    @default("PENDING")
  certificateSerial String?
  signatureHash     String?
  signedAt          DateTime?
  createdAt         DateTime  @default(now())
}

/// Har qanday muhim harakat shu yerga yoziladi - o'chirib bo'lmaydi (append-only).
model AuditLog {
  id         String    @id @default(uuid())
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  userId     String
  user       User      @relation("AuditUser", fields: [userId], references: [id])
  /// Qiymatlar: CREATE | UPDATE | STATUS_CHANGE | SIGN | DOWNLOAD | DELETE | LOGIN
  action     String
  /// JSON.stringify() bilan saqlanadi, o'qishda JSON.parse() qilinadi
  /// (SQLite'da native Json turi yo'q; PostgreSQL'ga o'tishda Json'ga qaytarish mumkin)
  metadata   String?
  createdAt  DateTime  @default(now())

  @@index([documentId])
  @@index([userId])
}

/// Kiruvchi/chiquvchi xatlar bo'limi (ogohlantirish, ma'lumotnoma, xat).
/// Document/Workflow modellaridan alohida - chunki maydonlari boshqacha
/// (kontragent nomi/adresi, telefon, qisqacha mazmun) va workflow zanjiri kerak emas.
model Letter {
  id       String @id @default(uuid())
  /// Qiymatlar: INCOMING | OUTGOING
  direction String
  /// Qiymatlar: WARNING | REFERENCE | LETTER
  type      String
  /// DRAFT | PENDING_APPROVAL | APPROVED | REJECTED | ARCHIVED | DELETED
  status    String @default("DRAFT")

  documentNumber      String
  documentDate        DateTime @default(now())
  /// ORGANIZATION | CITIZEN
  counterpartyType    String @default("ORGANIZATION")
  counterpartyName    String
  counterpartyAddress String?
  phoneNumber         String?
  summary             String
  bodyText            String?
  aiGenerated         Boolean @default(false)

  /// Faqat OGOHLANTIRISH (FIRST_WARNING/FINAL_WARNING) turidagi xatlar uchun ixtiyoriy maydonlar.
  /// Boshqa turlarda bo'sh (null) qoladi.
  contractNumber        String?
  contractDate          DateTime?
  monthlyPaymentAmount  Float?
  overdueDays           Int?
  charityAmount         Float?
  /// Har oyning nasiya to'lovi amalga oshirilishi kerak bo'lgan sanasi (kun raqami, masalan 15)
  paymentDueDay         Int?

  draftFileUrl        String?
  finalFileUrl        String?
  qrToken             String? @unique
  submittedAt         DateTime?
  approvedAt          DateTime?
  approvedById        String?
  /// Rahbariyat xatni rad etganda - sabab va vaqti
  rejectedAt          DateTime?
  rejectionReason     String?

  createdById String
  createdBy   User   @relation("LetterAuthor", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([direction])
  @@index([type])
  @@index([status])
}

// ==================== KADRLAR BO'LIMI ====================

/// Xodimning shaxsiy kartotekasi - kadrlar bo'limining asosiy yozuvi.
model Employee {
  id             String   @id @default(cuid())
  fullName       String
  position       String
  department     String?
  /// Ishga qabul qilingan sana
  hireDate       DateTime
  birthDate      DateTime?
  phone          String?
  email          String?
  /// Pasport seriyasi va raqami (masalan AA1234567)
  passportSerial String?
  /// Pasport berilgan sana
  passportIssueDate DateTime?
  /// Pasport amal qilish muddati - tugashiga yaqin xodimlar ajratib ko'rsatiladi
  passportExpiry DateTime?
  /// Pasportni bergan organ (masalan "Chilonzor tumani IIB")
  passportIssuedBy String?
  /// JSHSHIR (14 raqam)
  pinfl          String?
  address        String?
  /// ACTIVE | DISMISSED
  status         String   @default("ACTIVE")
  dismissDate    DateTime?
  notes          String?

  orders    HrOrder[]
  contracts EmploymentContract[]
  leaves    Leave[]
  attendance Attendance[]

  /// Bo'lim ma'lumotnomasi bilan bog'lanish (department matn maydoni saqlanib qoladi)
  departmentRef   Department? @relation(fields: [departmentRefId], references: [id])
  departmentRefId String?

  /// Tizim foydalanuvchisi bilan bog'lanish - "Mening HR" sahifasi uchun
  user   User?   @relation("EmployeeUser", fields: [userId], references: [id])
  userId String? @unique

  schedules   WorkSchedule[]
  gratitudes  Gratitude[]  @relation("GratitudeTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([fullName])
}

/// Xodimlar bo'yicha buyruqlar (ishga qabul, bo'shatish, lavozimga o'tkazish va h.k.)
model HrOrder {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  /// HIRE | DISMISS | TRANSFER | VACATION | BONUS | PENALTY | OTHER
  type       String
  /// Buyruq raqami - takrorlanmasligi dastur darajasida tekshiriladi
  /// (bazada @unique qo'yilmagan, chunki eski yozuvlarda dublikatlar bo'lishi mumkin)
  number     String
  orderDate  DateTime
  subject    String
  content    String?
  fileUrl    String?
  /// Ishga qabul buyrug'ida - shtat stavkasi (1.0 = to'liq stavka, 0.5 = yarim)
  rate       Float?

  createdBy   User?   @relation(fields: [createdById], references: [id])
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([type])
}

/// Xodim bilan tuzilgan mehnat shartnomasi
model EmploymentContract {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  number     String
  /// PERMANENT | FIXED_TERM | PART_TIME
  type       String   @default("PERMANENT")
  startDate  DateTime
  endDate    DateTime?
  salary     Float?
  fileUrl    String?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
}

/// Ta'til (otpuska) - ariza va grafik
model Leave {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  /// ANNUAL | UNPAID | SICK | MATERNITY | STUDY
  type       String   @default("ANNUAL")
  startDate  DateTime
  endDate    DateTime
  /// Ta'til kunlari soni
  days       Int
  /// REQUESTED | APPROVED | REJECTED
  status     String   @default("REQUESTED")
  reason     String?
  rejectionReason String?

  approvedBy   User?     @relation("LeaveApprover", fields: [approvedById], references: [id])
  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
}

/// Tashkilot bo'limlari (bo'linmalar). Ierarxiya uchun parentId ishlatiladi.
model Department {
  id       String  @id @default(cuid())
  name     String
  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  parentId String?
  children Department[] @relation("DepartmentTree")

  positions Position[]
  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Shtat lavozimlari
model Position {
  id           String      @id @default(cuid())
  title        String
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?
  /// Shtat birliklari soni
  headcount    Int         @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Bayram va dam olish kunlari - davomat jadvalida ajratib ko'rsatiladi
model Holiday {
  id   String   @id @default(cuid())
  date DateTime @unique
  name String
  /// HOLIDAY (bayram) | WORKDAY (dam olish kuni ish kuniga ko'chirilgan)
  type String   @default("HOLIDAY")

  createdAt DateTime @default(now())
}

/// Xodimlarning kunlik davomati
model Attendance {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  date       DateTime
  /// PRESENT | LATE | ABSENT | LEAVE | DAYOFF | HOLIDAY | SICK | BUSINESS_TRIP
  status     String   @default("PRESENT")
  /// Kechikkan daqiqalar (LATE holati uchun)
  lateMinutes Int?
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([date])
}


/// Xodimning haftalik ish jadvali (smena tarkibi)
model WorkSchedule {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  /// 0 = yakshanba ... 6 = shanba
  weekday    Int
  /// "09:00" ko'rinishida
  startTime  String?
  endTime    String?
  /// Dam olish kuni bo'lsa true
  isDayOff   Boolean  @default(false)
  shiftName  String   @default("Umumiy smena")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, weekday])
}

/// Minnatdorchilik (rag'batlantirish) - xodimga bildirilgan tashakkur
model Gratitude {
  id         String   @id @default(cuid())
  employee   Employee @relation("GratitudeTo", fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  author     User?    @relation("GratitudeFrom", fields: [authorId], references: [id])
  authorId   String?
  message    String
  createdAt  DateTime @default(now())

  @@index([employeeId])
}
